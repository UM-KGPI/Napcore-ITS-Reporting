@startuml
' System Context (Level 1)
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
left to right direction

skinparam rectangle {
  BackgroundColor #eef5ff
  BorderColor #1f3a93
}
skinparam actor {
  BackgroundColor #f7f7f7
  BorderColor #333333
}

actor "Pilot User\n(NAP Analyst)" as U1
actor "Administrator" as U2

rectangle "NAP ITS Reporter\n(Web Application)" as APP #d9f2e6

rectangle "NAP Catalogs and API Endpoints" as NAP #fff3e0
rectangle "DG MOVE Templates\nand Reporting Requirements" as DGMOVE #fff3e0
rectangle "mobilityDCAT-AP and RDF Standards\n(JSON-LD, TTL, RDF/XML)" as STD #fff3e0
rectangle "External Identity Provider\n(OIDC/SAML)" as IDP #fff3e0

U1 --> APP : review, validate, report
U2 --> APP : administer rules and access

APP --> NAP : discover and ingest metadata
APP --> DGMOVE : apply templates and KPI mapping
APP --> STD : apply validation semantics
APP --> IDP : authenticate and authorize users
@enduml
