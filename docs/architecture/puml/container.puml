@startuml
' Container Diagram (Level 2)
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
top to bottom direction

skinparam rectangle {
  BackgroundColor #eef5ff
  BorderColor #1f3a93
}
skinparam database {
  BackgroundColor #f3e8ff
  BorderColor #6b21a8
}

actor "Member state" as USER

package "NAP ITS Reporter" {
  rectangle "European Mobility Dataspace (EMDS) interface" as PATTERN #eef5ff

  package "Presentation Layer" as PRESENTATION {
    rectangle "Web UI\ncompliance dashboard + workflow view" as UI #d9f2e6
    rectangle "API Documentation Portal\nOpenAPI/Swagger" as APIDOC #d9f2e6
  }

  package "Logical Layer (Microservices/API)" as LOGIC {
    rectangle "API Gateway\nREST API + contracts" as BFF #dbeafe
    rectangle "Reporting Orchestrator\nend-to-end reporting workflow" as WF #dbeafe
    rectangle "Authorization service" as IAM #dbeafe
    rectangle "Federated Registry and Discoverability Service\nfor cross-NAP interoperability" as REGDISC #dbeafe
    rectangle "NAP Dataset Health Status Service\ntrusted dataset readiness evaluation" as DHS #dbeafe
    rectangle "1. Reporting Service\nguided + semi-auto + full-auto reporting" as REP #dbeafe
    rectangle "2. Metadata Ingestion Service\nautomated discovery + fetch + normalization" as ING #dbeafe
    rectangle "2.1 Validation service\nmobilityDCAT-AP consisteny check" as VAL #dbeafe
    rectangle "3. Complementary Data Service\nobtains additional reporting data" as COMP #dbeafe
    rectangle "4. KPI Mapping and Analytics Service\nmetadata -> KPI -> DG MOVE mappings" as KPI #dbeafe
    rectangle "Recommendation Service\nnon-compliance improvement suggestions" as REC #dbeafe
  }

  package "Data Layer" as DATA {
    database "Metadata Store\n(RDF triplestore)" as META
    database "Application DB" as APPDB
    database "Document Store\nreports + compliance outputs" as DOCS
    queue "Event Bus / Queue" as MQ
  }
}

rectangle "NAP Catalog and API Endpoints" as NAP #fff3e0
rectangle "DG MOVE Templates" as DGT #fff3e0

USER --> UI
UI --> BFF
USER --> APIDOC
APIDOC --> BFF
BFF --> IAM
BFF --> WF
BFF --> DHS

WF --> ING
WF --> REGDISC
WF --> DHS
WF --> VAL
WF --> KPI
WF --> REP
WF --> COMP
WF --> REC

ING --> REGDISC
REGDISC ..> PATTERN : implements
REGDISC --> NAP
DHS --> REGDISC
DHS --> NAP
DHS --> APPDB
ING --> META
VAL --> META
VAL --> APPDB
VAL --> DOCS
KPI --> META
KPI --> APPDB
COMP --> APPDB
REP --> DGT
REP --> DOCS
REP --> APPDB
REC --> APPDB

ING <--> MQ
VAL <--> MQ
KPI <--> MQ
COMP <--> MQ
REP <--> MQ

IAM --> APPDB

' Force layer stacking order from top to bottom
PRESENTATION -[hidden]down-> LOGIC
LOGIC -[hidden]down-> DATA
@enduml
