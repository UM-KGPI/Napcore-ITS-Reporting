@startuml
' Container Diagram (Level 2)
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
left to right direction

skinparam rectangle {
  BackgroundColor #eef5ff
  BorderColor #1f3a93
}
skinparam database {
  BackgroundColor #f3e8ff
  BorderColor #6b21a8
}

actor "User" as USER

package "NAP ITS Reporter" {
  package "Presentation Layer" {
    rectangle "Web UI\nvalidation dashboard + workflow view" as UI #d9f2e6
    rectangle "API Documentation Portal\nOpenAPI/Swagger" as APIDOC #d9f2e6
  }

  package "Logical Layer (Microservices/API)" {
    rectangle "API Gateway / BFF\nREST API + contracts" as BFF #dbeafe
    rectangle "Metadata Ingestion Service\nautomated discovery + fetch + normalization" as ING #dbeafe
    rectangle "Federated Registry and Discoverability Service\nNAP interlinking + searchable/explainable discovery" as REGDISC #dbeafe
    rectangle "Compliance Validation Service\ncompleteness + accuracy + consistency checks" as VAL #dbeafe
    rectangle "KPI Mapping and Analytics Service\nmetadata -> KPI -> DG MOVE mappings" as KPI #dbeafe
    rectangle "Reporting Service\nguided + semi-auto + full-auto reporting" as REP #dbeafe
    rectangle "Recommendation Service\nnon-compliance improvement suggestions" as REC #dbeafe
    rectangle "Workflow Orchestrator\nend-to-end reporting workflow" as WF #dbeafe
    rectangle "AuthN/AuthZ Service" as IAM #dbeafe
  }

  package "Data Layer" {
    database "Metadata Store\n(RDF triplestore)" as META
    database "Application DB" as APPDB
    database "Document Store\nreports + compliance outputs" as DOCS
    queue "Event Bus / Queue" as MQ
  }
}

rectangle "NAP Catalog and API Endpoints" as NAP #fff3e0
rectangle "Infrastructure Services" as INFRA #fff3e0
rectangle "DG MOVE Templates" as DGT #fff3e0
rectangle "External IdP" as IDP #fff3e0

USER --> UI
UI --> BFF
USER --> APIDOC
APIDOC --> BFF
BFF --> IAM
BFF --> WF

WF --> ING
WF --> REGDISC
WF --> VAL
WF --> KPI
WF --> REP
WF --> REC

ING --> REGDISC
REGDISC --> NAP
REGDISC --> INFRA
ING --> META
VAL --> META
VAL --> APPDB
VAL --> DOCS
KPI --> META
KPI --> APPDB
REP --> DGT
REP --> DOCS
REP --> APPDB
REC --> APPDB

ING <--> MQ
VAL <--> MQ
KPI <--> MQ
REP <--> MQ

IAM --> IDP
IAM --> APPDB
@enduml
