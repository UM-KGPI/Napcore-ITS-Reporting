digraph ContainerDiagramLR {
  graph [
    rankdir=LR,
    newrank=true,
    splines=ortho,
    ordering=out,
    nodesep=0.45,
    ranksep="1.0 equally",
    fontname="Helvetica"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#dbeafe",
    color="#1f3a93",
    fontname="Helvetica",
    fontsize=10,
    penwidth=1
  ];

  edge [
    color="#334155",
    fontname="Helvetica",
    fontsize=9,
    arrowsize=0.7
  ];

  USER [label="Member state", shape=plaintext];

  NAP [
    label="NAP Catalog and API Endpoints",
    fillcolor="#fff3e0",
    color="#92400e"
  ];

  DGT [
    label="DG MOVE Templates",
    fillcolor="#fff3e0",
    color="#92400e"
  ];

  subgraph cluster_PLATFORM {
    label="NAP ITS Reporter";
    style="rounded";
    color="#1f3a93";
    penwidth=1.2;

    PATTERN [
      label="European Mobility Dataspace (EMDS) interface",
      fillcolor="#eef5ff"
    ];

    subgraph cluster_PRESENTATION {
      label="Presentation Layer";
      style="rounded,filled";
      color="#1f3a93";
      fillcolor="#eef5ff";

      UI [label=<Web UI<BR/>dashboard + workflow view>, fillcolor="#d9f2e6"];
      APIDOC [label=<API Documentation Portal<BR/>OpenAPI/Swagger>, fillcolor="#d9f2e6"];
      P_CENTER [shape=point, width=0.01, style=invis, label=""];

      { rank=same; UI; APIDOC; P_CENTER; }
    }

    subgraph cluster_LOGIC {
      label="Logical Layer (Microservices/API)";
      style="rounded,filled";
      color="#1f3a93";
      fillcolor="#eef5ff";

      BFF [label=<API Gateway<BR/>REST API + contracts>];
      WF [label=<Reporting Orchestrator<BR/>end-to-end reporting workflow>];
      IAM [label="Authorization service"];
      REGDISC [label=<Federated Registry and Discoverability Service<BR/>for cross-NAP interoperability>];
      DHS [label=<NAP Dataset Health Status Service<BR/>trusted dataset readiness evaluation>];
      REP [label=<1. Reporting Service<BR/>guided + semi-auto + full-auto reporting>];
      ING [label=<2. Metadata Ingestion Service<BR/>automated discovery + fetch + normalization>];
      VAL [label=<2.1 Validation service<BR/>mobilityDCAT-AP consisteny check>];
      COMP [label=<3. Complementary Data Service<BR/>obtains additional reporting data>];
      KPI [label=<4. KPI Mapping and Analytics Service<BR/>metadata to KPI to DG MOVE mappings>];
      REC [label=<Recommendation Service<BR/>non-compliance improvement suggestions>];
      L_CENTER [shape=point, width=0.01, style=invis, label=""];

      { rank=same; BFF; IAM; }
      { rank=same; WF; L_CENTER; }
      { rank=same; REP; ING; VAL; COMP; KPI; REGDISC; DHS; REC; }

      // Service order: 1, 2, 2.1, 3, 4, NAP Dataset..., Federated..., then other unnumbered.
      REC -> REGDISC [style=invis, weight=1200];
      REGDISC -> DHS [style=invis, weight=1200];
      DHS -> KPI [style=invis, weight=1200];
      KPI -> COMP [style=invis, weight=1200];
      COMP -> VAL [style=invis, weight=1200];
      VAL -> ING [style=invis, weight=1200];
      ING -> REP [style=invis, weight=1200];
    }

    subgraph cluster_DATA {
      label="Data Layer";
      style="rounded,filled";
      color="#1f3a93";
      fillcolor="#eef5ff";

      META [label=<Metadata Store<BR/>(RDF triplestore)>, shape=cylinder, style="filled", fillcolor="#f3e8ff", color="#6b21a8"];
      APPDB [label="Application DB", shape=cylinder, style="filled", fillcolor="#f3e8ff", color="#6b21a8"];
      DOCS [label=<Document Store<BR/>reports + compliance outputs>, shape=cylinder, style="filled", fillcolor="#f3e8ff", color="#6b21a8"];
      MQ [label="Event Bus / Queue", shape=box3d, style="filled", fillcolor="#f3e8ff", color="#6b21a8"];
      D_CENTER [shape=point, width=0.01, style=invis, label=""];

      { rank=same; META; APPDB; DOCS; MQ; D_CENTER; }
    }
  }

  USER -> UI;
  USER -> APIDOC;
  UI -> BFF;
  APIDOC -> BFF;
  BFF -> IAM;
  BFF:e -> WF:w [weight=1800, minlen=1];
  BFF -> DHS [constraint=false];

  WF -> REP;
  WF -> ING [constraint=false];
  WF -> VAL [constraint=false];
  WF -> COMP [constraint=false];
  WF -> KPI [constraint=false];
  WF -> DHS [constraint=false];
  WF:s -> REGDISC:n [weight=2200, minlen=1, constraint=false];
  WF -> REC [constraint=false];

  ING -> REGDISC [constraint=false];
  REGDISC -> PATTERN [style=dashed, xlabel="implements", weight=1200, minlen=1];
  REGDISC -> NAP [weight=1200, minlen=1];
  DHS -> REGDISC [constraint=false];
  DHS -> NAP [weight=1000, minlen=1];
  DHS -> APPDB [constraint=false];
  ING -> META [constraint=false];
  VAL -> META [constraint=false];
  VAL -> APPDB [constraint=false];
  VAL -> DOCS [constraint=false];
  KPI -> META [constraint=false];
  KPI -> APPDB [constraint=false];
  COMP -> APPDB [constraint=false];
  REP -> DGT [weight=1000, minlen=1];
  REP -> DOCS [constraint=false];
  REP -> APPDB [constraint=false];
  REC -> APPDB [constraint=false];

  ING -> MQ [dir=both, constraint=false];
  VAL -> MQ [dir=both, constraint=false];
  KPI -> MQ [dir=both, constraint=false];
  COMP -> MQ [dir=both, constraint=false];
  REP -> MQ [dir=both, constraint=false];

  IAM -> APPDB [constraint=false];

  // Horizontal layer chain (left -> right) and center alignment.
  P_CENTER -> L_CENTER [style=invis, weight=700, minlen=1];
  L_CENTER -> D_CENTER [style=invis, weight=500, minlen=1];
  REP -> D_CENTER [style=invis, weight=1800, minlen=3];

  // Keep external/context nodes vertically aligned with the Data layer column.
  { rank=same; PATTERN; NAP; DGT; D_CENTER; }
}
