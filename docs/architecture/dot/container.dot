digraph ContainerDiagram {
  graph [
    rankdir=TB,
    newrank=true,
    splines=spline,
    nodesep=0.45,
    ranksep="1.0 equally",
    fontname="Helvetica"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#dbeafe",
    color="#1f3a93",
    fontname="Helvetica",
    fontsize=10,
    penwidth=1
  ];

  edge [
    color="#334155",
    fontname="Helvetica",
    fontsize=9,
    arrowsize=0.7
  ];

  USER [label="Member state", shape=plaintext];

  NAP [
    label="NAP Catalog and API Endpoints",
    fillcolor="#fff3e0",
    color="#92400e"
  ];

  DGT [
    label="DG MOVE Templates",
    fillcolor="#fff3e0",
    color="#92400e"
  ];

  subgraph cluster_PLATFORM {
    label="NAP ITS Reporter";
    style="rounded";
    color="#1f3a93";
    penwidth=1.2;

    PATTERN [
      label="European Mobility Dataspace (EMDS) interface",
      fillcolor="#eef5ff"
    ];

    subgraph cluster_PRESENTATION {
      label="Presentation Layer";
      style="rounded,filled";
      color="#1f3a93";
      fillcolor="#eef5ff";

      UI [label="Web UI\\ncompliance dashboard + workflow view", fillcolor="#d9f2e6"];
      APIDOC [label="API Documentation Portal\\nOpenAPI/Swagger", fillcolor="#d9f2e6"];
      P_CENTER [shape=point, width=0.01, style=invis, label=""];

      { rank=same; UI; APIDOC; P_CENTER; }
      UI -> P_CENTER [style=invis, weight=300];
      P_CENTER -> APIDOC [style=invis, weight=300];
    }

    subgraph cluster_LOGIC {
      label="Logical Layer (Microservices/API)";
      style="rounded,filled";
      color="#1f3a93";
      fillcolor="#eef5ff";

      BFF [label="API Gateway\\nREST API + contracts"];
      WF [label="Reporting Orchestrator\\nend-to-end reporting workflow"];
      IAM [label="Authorization service"];
      REGDISC [label="Federated Registry and Discoverability Service\\nfor cross-NAP interoperability"];
      DHS [label="NAP Dataset Health Status Service\\ntrusted dataset readiness evaluation"];
      REP [label="1. Reporting Service\\nguided + semi-auto + full-auto reporting"];
      ING [label="2. Metadata Ingestion Service\\nautomated discovery + fetch + normalization"];
      VAL [label="2.1 Validation service\\nmobilityDCAT-AP consisteny check"];
      COMP [label="3. Complementary Data Service\\nobtains additional reporting data"];
      KPI [label="4. KPI Mapping and Analytics Service\\nmetadata -> KPI -> DG MOVE mappings"];
      REC [label="Recommendation Service\\nnon-compliance improvement suggestions"];
      L_CENTER [shape=point, width=0.01, style=invis, label=""];

      { rank=same; BFF; IAM; }
      { rank=same; WF; L_CENTER; }
      { rank=same; REGDISC; DHS; REP; ING; VAL; COMP; KPI; REC; }
    }

    subgraph cluster_DATA {
      label="Data Layer";
      style="rounded,filled";
      color="#1f3a93";
      fillcolor="#eef5ff";

      META [label="Metadata Store\\n(RDF triplestore)", shape=cylinder, style="filled", fillcolor="#f3e8ff", color="#6b21a8"];
      APPDB [label="Application DB", shape=cylinder, style="filled", fillcolor="#f3e8ff", color="#6b21a8"];
      DOCS [label="Document Store\\nreports + compliance outputs", shape=cylinder, style="filled", fillcolor="#f3e8ff", color="#6b21a8"];
      MQ [label="Event Bus / Queue", shape=box3d, style="filled", fillcolor="#f3e8ff", color="#6b21a8"];
      D_CENTER [shape=point, width=0.01, style=invis, label=""];

      { rank=same; META; APPDB; DOCS; MQ; D_CENTER; }
    }
  }

  USER -> UI;
  USER -> APIDOC;
  UI -> BFF;
  APIDOC -> BFF;
  BFF -> IAM;
  BFF -> WF;
  BFF -> DHS;

  WF -> ING;
  WF -> REGDISC;
  WF -> DHS;
  WF -> VAL;
  WF -> KPI;
  WF -> REP;
  WF -> COMP;
  WF -> REC;

  ING -> REGDISC;
  REGDISC -> PATTERN [style=dashed, label="implements"];
  REGDISC -> NAP;
  DHS -> REGDISC;
  DHS -> NAP;
  DHS -> APPDB;
  ING -> META;
  VAL -> META;
  VAL -> APPDB;
  VAL -> DOCS;
  KPI -> META;
  KPI -> APPDB;
  COMP -> APPDB;
  REP -> DGT;
  REP -> DOCS;
  REP -> APPDB;
  REC -> APPDB;

  ING -> MQ [dir=both];
  VAL -> MQ [dir=both];
  KPI -> MQ [dir=both];
  COMP -> MQ [dir=both];
  REP -> MQ [dir=both];

  IAM -> APPDB;

  // Layer stacking and center alignment.
  L_CENTER -> P_CENTER [style=invis, weight=700, minlen=1];
  P_CENTER -> D_CENTER [style=invis, weight=500, minlen=1];
}
