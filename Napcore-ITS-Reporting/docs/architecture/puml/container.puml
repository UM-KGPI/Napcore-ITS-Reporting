@startuml
' Container Diagram (Level 2)
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
left to right direction

skinparam rectangle {
  BackgroundColor #eef5ff
  BorderColor #1f3a93
}
skinparam database {
  BackgroundColor #f3e8ff
  BorderColor #6b21a8
}

actor "User" as USER

rectangle "Web UI\nSPA + guided workflow" as UI #d9f2e6
rectangle "API Gateway / BFF\nREST API + contracts" as BFF #dbeafe

package "Core Services" {
  rectangle "Metadata Ingestion Service" as ING #dbeafe
  rectangle "Compliance Validation Service" as VAL #dbeafe
  rectangle "KPI Mapping and Analytics Service" as KPI #dbeafe
  rectangle "Reporting Service" as REP #dbeafe
  rectangle "Recommendation Service" as REC #dbeafe
  rectangle "Workflow Orchestrator" as WF #dbeafe
  rectangle "AuthN/AuthZ Service" as IAM #dbeafe
}

database "Metadata Store\n(RDF triplestore)" as META
database "Application DB" as APPDB
database "Document Store" as DOCS
queue "Event Bus / Queue" as MQ

rectangle "NAP API Endpoints" as NAP #fff3e0
rectangle "DG MOVE Templates" as DGT #fff3e0
rectangle "External IdP" as IDP #fff3e0

USER --> UI
UI --> BFF
BFF --> IAM
BFF --> WF

WF --> ING
WF --> VAL
WF --> KPI
WF --> REP
WF --> REC

ING --> NAP
ING --> META
VAL --> META
VAL --> APPDB
KPI --> META
KPI --> APPDB
REP --> DGT
REP --> DOCS
REP --> APPDB
REC --> APPDB

ING <--> MQ
VAL <--> MQ
KPI <--> MQ
REP <--> MQ

IAM --> IDP
IAM --> APPDB
@enduml
